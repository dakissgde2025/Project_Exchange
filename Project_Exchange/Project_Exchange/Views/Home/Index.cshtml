@{
    ViewData["Title"] = "Golden Scale – Érték és bizalom több mint 35 éve";
}

<section class="hero-section rounded-4 p-4 p-md-5 mb-5 text-white">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="hero-eyebrow">Cégbemutató</p>
            <h1 class="display-5 fw-bold mb-3">Érték és bizalom több mint 35 éve</h1>
            <p class="lead mb-4">
                1988 óta állunk ügyfeleink szolgálatában, és három évtizede ötvözzük a szakértelmet a családi
                tradíciókkal.
                Értékbecsléssel, antik és ritka tárgyak felvásárlásával, családi örökségek korrekt áron történő
                megvásárlásával
                és pénzváltással foglalkozunk. Nálunk minden ügyfél partner, közösségünk értékes része.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-light btn-lg fw-bold" asp-controller="Appointments"
                    asp-action="Index">Időpontfoglalás</a>
                <a class="btn btn-outline-light btn-lg fw-bold" asp-controller="Rates" asp-action="Index">Aktuális
                    árfolyamok</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-card shadow-lg rounded-4 p-4 h-100">
                <h2 class="h4 fw-bold mb-3" style="color: var(--brown-dark);">Mit jelent a Golden Scale?</h2>
                <ul class="list-unstyled mb-4">
                    <li class="d-flex align-items-start gap-2 mb-2">
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mt-1"
                            style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">1</span>
                        <span style="color: var(--brown-medium);">Bizalom, korrektség és diszkrét ügyintézés.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2 mb-2">
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mt-1"
                            style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">2</span>
                        <span style="color: var(--brown-medium);">Piaci alapon történő felvásárlás antikvitásokra és
                            relikviákra.</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mt-1"
                            style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">3</span>
                        <span style="color: var(--brown-medium);">Kedvező árfolyamú, biztonságos pénzváltás.</span>
                    </li>
                </ul>
                <p class="mb-0" style="color: var(--brown-light);">Munkánk alapja a szakmai tapasztalat és az ügyfelek
                    megbecsülése.</p>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-6">
            <div class="info-card h-100 shadow-sm rounded-4 p-4 p-lg-5">
                <p class="text-uppercase text-muted mb-1">Értékbecslés</p>
                <h2 class="h4 fw-bold mb-3">Szakértő csapat, valós piaci árak</h2>
                <p>Antik tárgyak, relikviák, műtárgyak és hagyatékok esetén minden értékbecslésünk naprakész piaci
                    adatokra és több évtizedes tapasztalatra épül.</p>
                <p class="mb-4">Akár eladás, akár hagyatéki ügyintézés, ügyfeleink minden esetben reális, korrekt
                    ajánlatot kapnak.</p>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="feature-pill">
                            <span class="h5 fw-bold d-block mb-1">Gyors</span>
                            Legkésőbb 3 munkanapon belül küldjük az eredményt.
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="feature-pill">
                            <span class="h5 fw-bold d-block mb-1">Ingyenes</span>
                            Díjmentes értékbecslés, rejtett költségek nélkül.
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="info-card h-100 shadow-sm rounded-4 p-4 p-lg-5 d-flex flex-column gap-4">
                <div>
                    <h3 class="h5 fw-bold mb-2">Relikviák és antik tárgyak felvásárlása</h3>
                    <p class="mb-0">Minden darab történelmet hordoz, ezért a felvásárlás átlátható módon, aktuális piaci
                        értéken történik. Ritka pénzérmék, gyűjtemények és antikvitások is biztonságban vannak nálunk.
                    </p>
                </div>
                <div>
                    <h3 class="h5 fw-bold mb-2">Családi örökségek</h3>
                    <p class="mb-0">Empatikus és diszkrét ügyintézéssel gondoskodunk arról, hogy az örökségek valódi
                        értéken találjanak új gazdára.</p>
                </div>
                <div>
                    <h3 class="h5 fw-bold mb-2">Pénzváltás</h3>
                    <p class="mb-0">Gyors, biztonságos és kedvező árfolyamú váltás. Az aktuális jegyzéseket az MNB
                        hivatalos adatai alapján frissítjük.</p>
                    <a class="text-decoration-none fw-semibold" asp-controller="Rates" asp-action="Index">Árfolyamok
                        megtekintése →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div
        class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-3">
        <div>
            <p class="text-uppercase text-muted mb-1">Képes ajánló</p>
            <h2 class="h3 fw-bold mb-0">Tevékenységeink képekben</h2>
            <p class="mb-0 text-muted">Valós pillanatképek a bolt hangulatáról és az általunk gondozott értékekről.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Index">Értékbecslés indítása</a>
    </div>
    <div class="info-card shadow-sm rounded-4 p-0 overflow-hidden">
        <div id="activityCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#activityCarousel" data-bs-slide-to="0" class="active"
                    aria-current="true" aria-label="Értékbecslés"></button>
                <button type="button" data-bs-target="#activityCarousel" data-bs-slide-to="1"
                    aria-label="Antikvitások"></button>
                <button type="button" data-bs-target="#activityCarousel" data-bs-slide-to="2"
                    aria-label="Családi örökségek"></button>
                <button type="button" data-bs-target="#activityCarousel" data-bs-slide-to="3"
                    aria-label="Érme felvásárlás"></button>
                <button type="button" data-bs-target="#activityCarousel" data-bs-slide-to="4"
                    aria-label="Pénzváltás"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/slide/ertekbecsles.jpg" class="d-block w-100 carousel-image" alt="Értékbecslés">
                    <div class="carousel-caption text-start">
                        <h3 class="h5 fw-bold">Értékbecslés</h3>
                        <p>Szakértő munkatársaink megbízható, átlátható értékbecsléseket készítenek minden tárgyról.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/slide/antikvitas.jpg" class="d-block w-100 carousel-image" alt="Antikvitások">
                    <div class="carousel-caption text-start">
                        <h3 class="h5 fw-bold">Relikviák és antikvitások</h3>
                        <p>Ritka, történelmi értéket képviselő darabokat vásárolunk fel piaci alapon, korrekt módon.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/slide/csalad_orokseg.jpg" class="d-block w-100 carousel-image"
                        alt="Családi örökségek">
                    <div class="carousel-caption text-start">
                        <h3 class="h5 fw-bold">Családi örökségek</h3>
                        <p>Empatikus, diszkrét ügyintézéssel gondoskodunk az örökségek méltó sorsáról.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/slide/regi_erme.jpg" class="d-block w-100 carousel-image" alt="Régi érme">
                    <div class="carousel-caption text-start">
                        <h3 class="h5 fw-bold">Ritka pénzérmék</h3>
                        <p>Gyűjtemények, érmék és különleges darabok felvásárlása naprakész piaci árakon.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/images/slide/penzvaltas.jpg" class="d-block w-100 carousel-image" alt="Pénzváltás">
                    <div class="carousel-caption text-start">
                        <h3 class="h5 fw-bold">Pénzváltás</h3>
                        <p>Kedvező árfolyamok, gyors ügyintézés és biztonságos környezet várja ügyfeleinket.</p>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#activityCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Előző</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#activityCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Következő</span>
            </button>
        </div>
    </div>
</section>

<section class="cta-card rounded-4 p-4 p-md-5 text-white mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <p class="text-uppercase text-white-50 mb-1">Foglaljon online</p>
            <h2 class="h3 fw-bold mb-3">Időpontfoglalás és árfolyamok egy helyen</h2>
            <p class="mb-0">Válassza ki a kívánt szolgáltatást és időpontot, mi pedig gondoskodunk róla, hogy minden
                gördülékenyen menjen.</p>
        </div>
        <div class="col-lg-4 text-lg-end d-flex flex-column flex-lg-row gap-3 justify-content-lg-end">
            <a class="btn btn-light btn-lg text-primary flex-grow-1" asp-controller="Appointments"
                asp-action="Index">Értékbecslés foglalása</a>
            <a class="btn btn-outline-light btn-lg flex-grow-1" asp-controller="Rates" asp-action="Index">Árfolyamok</a>
        </div>
    </div>
</section>
