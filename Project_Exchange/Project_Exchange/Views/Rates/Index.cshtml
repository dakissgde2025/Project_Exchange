@model Project_Exchange.Models.ExchangeRatesPageViewModel
@{
    ViewData["Title"] = "Aktuális devizaárfolyamok";
}

<section class="my-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
        <div>
            <p class="text-uppercase text-muted mb-1">MNB hivatalos középárfolyamok</p>
            <h1 class="h3 fw-bold mb-0">@ViewData["Title"]</h1>
        </div>
        <div class="text-md-end">
            <p class="text-muted mb-1">Frissítve: @Model.RetrievedAtUtc.ToLocalTime().ToString("yyyy. MMMM dd. HH:mm")</p>
            <a class="btn btn-outline-primary" asp-action="Index">Táblázat frissítése</a>
        </div>
    </div>

    @if (Model.HasError)
    {
        <div class="alert alert-warning">Jelenleg nem érhetők el az árfolyam adatok. Kérjük próbálja újra később.</div>
    }

    <div class="table-responsive shadow-sm rounded-4 overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Valuta</th>
                    <th class="text-end">Egység</th>
                    <th class="text-end">MNB középárfolyam (HUF)</th>
                    <th class="text-end">1 egységre átszámítva</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rate in Model.Rates)
                {
                    <tr class="@(rate.Unit > 1 ? "table-striped-highlight" : string.Empty)">
                        <td class="fw-semibold">@rate.Currency</td>
                        <td class="text-end">@rate.Unit</td>
                        <td class="text-end">@rate.Value.ToString("N3")</td>
                        <td class="text-end">@rate.ValuePerOneUnit.ToString("N3")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

